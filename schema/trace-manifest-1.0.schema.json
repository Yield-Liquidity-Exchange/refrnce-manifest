{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trace Manifest envelope (trace-manifest/1.0)",
  "description": "Envelope of a Trace Manifest, schema trace-manifest/1.0. Definitions: envelope, manifest, claim.\nThis file states structure only. A verifier must also check the rules below, which JSON Schema cannot express:\ncall checkManifestRules (src/manifest/manifest-rules.ts) on the parsed record, and detectDuplicateKeys on the raw text before parsing it.\n- issued_at is a real calendar date (30 February is refused).\n- claim ids are unique.\n- every claim reference (provenance.inputs, provenance.basis, value.from_owner_claim, value.to_owner_claim) names a claim in the manifest and not the claim itself.\n- claim.type equals claim.provenance.type.\n- every formula a derived claim cites is listed in tooling.formulas.\n- artifact names are unique ignoring case.\n- claim.code is in the claim rules table and claim.type is the one type the table allows for that code (assertClaimAllowed).\n- every observed claim's provenance.signature is one of subject.signatures.\n- signature.key_id equals manifest.issuer.key_id (checked when an envelope is given).\n- anchor.memo equals trace-manifest:1: followed by manifest_hash (checked when an envelope is given).\n- no number is negative zero (JSON.parse reads -0 as -0, and the canonical text writes 0).\n- no object has an own __proto__ key (it would be dropped silently when parsed into an ordinary object).\n- claim values nest at most 64 levels.\n- no string is longer than 20000 characters and the canonical manifest is at most 16 MB (the builder refuses more, and a verifier should too).\n- an attributed claim's retrieved_at is a real calendar day.\n- tooling matches the claims: every TX_FEE claim's decoder equals tooling.normaliser, and every PROGRAM_LABEL source is trace-program-registry@ followed by the version of tooling.decoder_registry. The versions of individual instruction decoders are not stamped in tooling, so they are not cross-checked; each claim names its own.\n- the manifest has a canonical form: a lone surrogate (or anything else canonicalisation refuses) makes canonicalisation throw, so check C2 must report a failure and not crash.\n- no JSON object repeats a key. JSON.parse keeps the last of two equal keys without a word, so a verifier must run detectDuplicateKeys on the raw text before parsing it.\nKnown limitation: the claims' own decoder versions are not stamped in tooling; see tooling_matches_claims above.",
  "$ref": "#/definitions/envelope",
  "definitions": {
    "manifest": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "trace-manifest/1.0"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^TRC-[0-9A-HJKMNP-TV-Z]{12}$"
        },
        "issuer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[ -~]{1,100}$"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            }
          },
          "required": [
            "name",
            "key_id"
          ],
          "additionalProperties": false
        },
        "issued_at": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "subject": {
          "type": "object",
          "properties": {
            "chain": {
              "type": "string",
              "const": "solana"
            },
            "cluster": {
              "type": "string",
              "enum": [
                "mainnet-beta",
                "devnet",
                "testnet"
              ]
            },
            "signatures": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
              },
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true
            }
          },
          "required": [
            "chain",
            "cluster",
            "signatures"
          ],
          "additionalProperties": false
        },
        "tooling": {
          "type": "object",
          "properties": {
            "normaliser": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._+-]+@[A-Za-z0-9._+-]+$"
            },
            "decoder_registry": {
              "$ref": "#/definitions/manifest/properties/tooling/properties/normaliser"
            },
            "formulas": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/manifest/properties/tooling/properties/normaliser"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "normaliser",
            "decoder_registry",
            "formulas"
          ],
          "additionalProperties": false
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/claim"
          },
          "minItems": 1,
          "maxItems": 100000
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(?![Cc][Oo][Nn](?:\\.|$)|[Pp][Rr][Nn](?:\\.|$)|[Aa][Uu][Xx](?:\\.|$)|[Nn][Uu][Ll](?:\\.|$)|[Cc][Oo][Mm][1-9](?:\\.|$)|[Ll][Pp][Tt][1-9](?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schema",
        "trace_id",
        "issuer",
        "issued_at",
        "subject",
        "tooling",
        "claims",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c-(?!0000$)(\\d{4}|[1-9]\\d{4,})$"
        },
        "type": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "attributed",
            "inferred"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/claim/properties/value"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/claim/properties/value"
              }
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "observed"
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                },
                "slot": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "ix_path": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.(0|[1-9]\\d*))*$"
                },
                "decoder": {
                  "$ref": "#/definitions/manifest/properties/tooling/properties/normaliser"
                }
              },
              "required": [
                "type",
                "signature",
                "slot",
                "ix_path",
                "decoder"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "derived"
                },
                "formula": {
                  "$ref": "#/definitions/manifest/properties/tooling/properties/normaliser"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/claim/properties/id"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "type",
                "formula",
                "inputs"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "attributed"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "retrieved_at": {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d+)?Z$"
                }
              },
              "required": [
                "type",
                "source"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "inferred"
                },
                "analyst_id": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/claim/properties/id"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "type",
                "analyst_id",
                "basis"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "type",
        "code",
        "value",
        "provenance"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "properties": {
        "manifest": {
          "$ref": "#/definitions/manifest"
        },
        "manifest_hash": {
          "$ref": "#/definitions/manifest/properties/artifacts/items/properties/sha256"
        },
        "signature": {
          "type": "object",
          "properties": {
            "alg": {
              "type": "string",
              "const": "Ed25519"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "value": {
              "$ref": "#/definitions/manifest/properties/subject/properties/signatures/items"
            }
          },
          "required": [
            "alg",
            "key_id",
            "value"
          ],
          "additionalProperties": false
        },
        "anchor": {
          "type": "object",
          "properties": {
            "cluster": {
              "$ref": "#/definitions/manifest/properties/subject/properties/cluster"
            },
            "tx_signature": {
              "$ref": "#/definitions/manifest/properties/subject/properties/signatures/items"
            },
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "block_time": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "memo": {
              "type": "string",
              "pattern": "^trace-manifest:1:sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "cluster",
            "tx_signature",
            "slot",
            "block_time",
            "memo"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "manifest",
        "manifest_hash",
        "signature",
        "anchor"
      ],
      "additionalProperties": false
    }
  }
}
